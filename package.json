{
  "name": "typecho-mcp-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first MCP publishing workbench for Typecho blogs over SSH.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "smoke": "bash tests/smoke.sh",
    "console": "node apps/local-service/src/server.js",
    "desktop:dev": "cargo tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "cargo tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:alpha:build": "cargo build --manifest-path apps/desktop/src-tauri/Cargo.toml --release --offline && bash apps/desktop/scripts/bundle-macos-app.sh",
    "mcp:stdio": "node packages/mcp-server/src/server.js",
    "probe:host": "node apps/local-service/src/cli.js probe --host typecho-host",
    "health:host": "node apps/local-service/src/cli.js agent:health --host typecho-host",
    "posts:host": "node apps/local-service/src/cli.js posts:list --host typecho-host --limit 10"
  },
  "keywords": [
    "typecho",
    "mcp",
    "markdown",
    "ssh",
    "blog",
    "ai-agent"
  ],
  "license": "UNLICENSED"
}
